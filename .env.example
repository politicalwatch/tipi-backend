NAME=Test
DESCRIPTION="This document includes all the methods that the {} API offers its users"
VERSION=1.0
DEBUG=True
IP=0.0.0.0
PORT=5000
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB_NAME=qhlddb
MONGO_USER=qhld
MONGO_PASSWORD=qhld
USE_ALERTS=True
COUNTRY=spain
# --- Semantic search (qhld-ai; /speeches/search) ---
# Must mirror qhld-engine's indexing config: the Qdrant collection name derives
# from embedding provider/model/dim + sparse, so a mismatch searches an empty
# collection. Without the AI stack, exclude the namespace instead:
# EXCLUDE_NAMESPACES=search
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# OLLAMA_BASE_URL default (http://host.docker.internal:11434) already targets host Ollama from the container.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:567m
SPARSE_PROVIDER=bm25
QUERY_PARSER_PROVIDER=llm
QUERY_PARSER_LLM_PROVIDER=ollama
QUERY_PARSER_LLM_MODEL=gpt-oss:20b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
