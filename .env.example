NAME=Test
DESCRIPTION="This document includes all the methods that the {} API offers its users"
VERSION=1.0
DEBUG=True
IP=0.0.0.0
PORT=5000
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB_NAME=qhlddb
MONGO_USER=qhld
MONGO_PASSWORD=qhld
USE_ALERTS=True
COUNTRY=spain
# Which hops uvicorn trusts to set X-Forwarded-For, i.e. what the per-IP rate limits key
# on. The image defaults to "*", which trusts (and therefore lets a caller forge) any
# value; set this to the address or network of the proxy that actually fronts the
# deployment. A host that does NOT front us is worse than "*": every client then shares a
# single bucket. Read by uvicorn itself, not by Settings.
# FORWARDED_ALLOW_IPS=*
# Shared secret for POST /search-ratings, sent as X-QHLD-Token. Must match the
# frontend's NUXT_SEARCH_RATING_TOKEN — that is what makes a rating provably ours
# while there are no user accounts. Empty rejects every rating (fails closed).
SEARCH_RATING_TOKEN=
# --- Semantic search (qhld-ai; /speeches/search) ---
# Must mirror qhld-engine's indexing config: the Qdrant collection name derives
# from embedding provider/model/dim + sparse + quantization, so a mismatch
# searches an empty collection. Without the AI stack, exclude the namespace
# instead:
# EXCLUDE_NAMESPACES=search
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# OLLAMA_BASE_URL default (http://host.docker.internal:11434) already targets host Ollama from the container.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:567m
SPARSE_PROVIDER=bm25
# Compression is part of the collection's identity, so the reader has to name the
# same scheme the indexer built with. Rescore and hnsw_ef are query-time instead:
# they tune this search without changing which collection it reads.
QDRANT_QUANTIZATION=tq4
QDRANT_QUANTIZATION_RESCORE=false
QDRANT_HNSW_EF=1024
QUERY_PARSER_PROVIDER=llm
QUERY_PARSER_LLM_PROVIDER=ollama
QUERY_PARSER_LLM_MODEL=gpt-oss:20b
# How much the model reasons first. OpenAI family only — ollama ignores it. Empty
# leaves each model's own default, and those differ between models, so an A/B that
# doesn't set it is not comparing like with like. Production: gpt-5.6-luna at "low".
QUERY_PARSER_LLM_REASONING_EFFORT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
